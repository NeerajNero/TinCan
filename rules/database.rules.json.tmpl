{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && $uid === auth.uid",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.val() === 'awake' || newData.val() === 'sleeping'" },
        "page": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "$other": { ".validate": false }
      }
    },
    "typing": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && $uid === auth.uid",
        ".validate": "newData.isNumber()"
      }
    },
    "pings": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        "$pushId": {
          ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && ((!data.exists() && newData.exists() && $uid !== auth.uid) || (data.exists() && !newData.exists() && $uid === auth.uid))",
          ".validate": "newData.hasChildren(['from', 'kind', 'at']) && newData.child('from').val() === auth.uid && newData.child('kind').isString()"
        }
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && $uid === auth.uid",
        "$pushId": {
          ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && ((!data.exists() && newData.exists() && $uid !== auth.uid) || (data.exists() && !newData.exists() && $uid === auth.uid))",
          ".validate": "newData.hasChildren(['from', 'activity', 'label', 'route', 'at']) && newData.child('from').val() === auth.uid && newData.child('activity').isString() && newData.child('activity').val().length >= 1 && newData.child('activity').val().length <= 32 && newData.child('label').isString() && newData.child('label').val().length >= 1 && newData.child('label').val().length <= 80 && newData.child('route').isString() && newData.child('route').val().matches(/^\\/([a-zA-Z0-9_?=&.-][a-zA-Z0-9\\/_?=&.-]{0,98})?$/) && newData.child('at').isNumber() && newData.child('at').val() <= now",
          "from": { ".validate": true },
          "activity": { ".validate": true },
          "label": { ".validate": true },
          "route": { ".validate": true },
          "at": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    },
    "lamp": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".validate": "newData.hasChildren(['on', 'color', 'until']) && newData.child('on').isBoolean() && newData.child('color').isString() && newData.child('until').isNumber()"
      }
    },
    "cursors": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && $uid === auth.uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('x').val() >= 0 && newData.child('x').val() <= 1 && newData.child('y').isNumber() && newData.child('y').val() >= 0 && newData.child('y').val() <= 1)"
      }
    },
    "whiteboard": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      "strokes": {
        "$strokeId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'points', 'color', 'width']) && newData.child('uid').val() === auth.uid && newData.child('points').isString() && newData.child('points').val().length <= 24000 && newData.child('color').isString() && newData.child('color').val().matches(/^#[0-9a-fA-F]{6}$/) && newData.child('width').isNumber())"
        }
      },
      "live": {
        "$uid": {
          ".validate": "!newData.exists() || ($uid === auth.uid && newData.child('points').isString() && newData.child('points').val().length <= 24000)"
        }
      }
    },
    "pixel": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      "grid": { ".validate": "newData.isString() && newData.val().length === 1024" },
      "cursor": {
        "$uid": {
          ".validate": "$uid === auth.uid"
        }
      }
    },
    "games": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".indexOn": ["open"],
      "$gameId": {
        ".validate": "newData.hasChildren(['type', 'state', 'turn', 'players', 'status', 'open'])",
        "type": { ".validate": "newData.val() === 'tictactoe' || newData.val() === 'connectfour' || newData.val() === 'chess' || newData.val() === 'checkers' || newData.val() === 'dots' || newData.val() === 'hangman' || newData.val() === 'battleship'" },
        "state": { ".validate": "newData.isString() && newData.val().length < 20000" },
        "turn": { ".validate": "newData.val() === 'first' || newData.val() === 'second'" },
        "status": { ".validate": "newData.val() === 'invited' || newData.val() === 'active' || newData.val() === 'finished' || newData.val() === 'declined'" },
        "open": { ".validate": "newData.isBoolean()" },
        "endReason": { ".validate": "!newData.exists() || newData.val() === 'win' || newData.val() === 'draw' || newData.val() === 'resign' || newData.val() === 'abandoned' || newData.val() === 'cancelled'" },
        "players": { ".validate": "newData.hasChildren(['first', 'second'])" }
      }
    },
    "gameReactions": {
      "$gameId": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        "$pushId": {
          ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && ((!data.exists() && newData.exists()) || !newData.exists())",
          ".validate": "newData.hasChildren(['by', 'emoji', 'at']) && newData.child('by').val() === auth.uid && newData.child('emoji').isString() && newData.child('emoji').val().length >= 1 && newData.child('emoji').val().length <= 8 && newData.child('at').isNumber()",
          "by": { ".validate": true },
          "emoji": { ".validate": true },
          "at": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    },
    "gamePrivate": {
      "$gameId": {
        "$uid": {
          ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && $uid === auth.uid",
          ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && $uid === auth.uid",
          "word": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20 && newData.val().matches(/^[a-z]([a-z ]*[a-z])?$/)" },
          "round": { ".validate": "newData.isNumber()" },
          "fleet": { ".validate": "newData.isString() && newData.val().length <= 600" },
          "$other": { ".validate": false }
        }
      }
    },
    "cards": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "pictionary": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".indexOn": ["open"],
      "$gameId": {
        "strokes": {
          "$strokeId": {
            ".validate": "!newData.exists() || (newData.child('points').isString() && newData.child('points').val().length <= 24000 && newData.child('color').val().matches(/^#[0-9a-fA-F]{6}$/))"
          }
        },
        "live": {
          "$uid": {
            ".validate": "!newData.exists() || ($uid === auth.uid && newData.child('points').val().length <= 24000)"
          }
        }
      }
    },
    "watch": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "listen": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "roomchat": {
      "$room": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && ($room === 'watch' || $room === 'listen')",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && ($room === 'watch' || $room === 'listen') && !newData.exists()",
        "$msg": {
          ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && ($room === 'watch' || $room === 'listen') && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists()))",
          ".validate": "newData.hasChildren(['uid', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 500 && newData.child('at').isNumber() && newData.child('at').val() <= now",
          "uid": { ".validate": "newData.isString()" },
          "text": { ".validate": true },
          "at": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    },
    "radio": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "timer": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "cook": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "twenty": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "trivia": {
      "$roundId": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        "qIndex": { ".validate": "newData.isNumber()" },
        "qStartedAt": { ".validate": "newData.isNumber()" },
        "startedBy": { ".validate": "newData.isString()" },
        "joined": {
          "$uid": { ".validate": "newData.isNumber() && ($uid === auth.uid || (data.exists() && newData.val() === data.val()))" }
        },
        "answered": {
          "$uid": { ".validate": "newData.isNumber() && ($uid === auth.uid || (data.exists() && newData.val() === data.val()))" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
