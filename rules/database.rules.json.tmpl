{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && $uid === auth.uid",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.val() === 'awake' || newData.val() === 'sleeping'" },
        "page": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },
    "typing": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && $uid === auth.uid",
        ".validate": "newData.isNumber()"
      }
    },
    "pings": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        "$pushId": {
          ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && ((!data.exists() && newData.exists() && $uid !== auth.uid) || (data.exists() && !newData.exists() && $uid === auth.uid))",
          ".validate": "newData.hasChildren(['from', 'kind', 'at']) && newData.child('from').val() === auth.uid && newData.child('kind').isString()"
        }
      }
    },
    "lamp": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".validate": "newData.hasChildren(['on', 'color', 'until']) && newData.child('on').isBoolean() && newData.child('color').isString() && newData.child('until').isNumber()"
      }
    },
    "cursors": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
        ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__ && $uid === auth.uid"
      }
    },
    "whiteboard": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      "strokes": {
        "$strokeId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'points']) && newData.child('uid').val() === auth.uid)"
        }
      }
    },
    "pixel": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      "cursor": {
        "$uid": {
          ".validate": "$uid === auth.uid"
        }
      }
    },
    "games": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".indexOn": ["open"],
      "$gameId": {
        ".validate": "newData.hasChildren(['type', 'state', 'turn', 'players', 'status', 'open'])",
        "type": { ".validate": "newData.val() === 'tictactoe' || newData.val() === 'connectfour' || newData.val() === 'chess' || newData.val() === 'checkers'" },
        "state": { ".validate": "newData.isString() && newData.val().length < 20000" },
        "turn": { ".validate": "newData.val() === 'first' || newData.val() === 'second'" },
        "status": { ".validate": "newData.val() === 'invited' || newData.val() === 'active' || newData.val() === 'finished' || newData.val() === 'declined'" },
        "open": { ".validate": "newData.isBoolean()" },
        "endReason": { ".validate": "!newData.exists() || newData.val() === 'win' || newData.val() === 'draw' || newData.val() === 'resign' || newData.val() === 'abandoned' || newData.val() === 'cancelled'" },
        "players": { ".validate": "newData.hasChildren(['first', 'second'])" },
        "reaction": { ".validate": "newData.hasChildren(['by', 'emoji', 'at']) && newData.child('by').val() === auth.uid && newData.child('emoji').isString()" }
      }
    },
    "cards": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "pictionary": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "watch": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "listen": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "radio": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "timer": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "cook": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    },
    "twenty": {
      ".read": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__",
      ".write": "auth != null && auth.token.email_verified === true && __ALLOWED_EMAILS__"
    }
  }
}
