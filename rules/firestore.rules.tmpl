rules_version = '2';

// Tincan — Firestore rules. Generated from rules/firestore.rules.tmpl by
// scripts/build-rules.mjs, which fills in the two allowlisted emails.
// Everything not matched below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in __ALLOWED_EMAILS__;
    }
    function uid() { return request.auth.uid; }
    function isMe(id) { return allowed() && uid() == id; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changedKeys() { return incoming().diff(existing()).affectedKeys(); }
    function onlyChanges(keys) { return changedKeys().hasOnly(keys); }
    function mapDiffKeys(field) {
      return incoming().get(field, {}).diff(existing().get(field, {})).affectedKeys();
    }
    function hasField(data, field) { return field in data && data[field] != null; }
    /** Doc ids like `{dateKey}_{uid}` must end with the caller's uid. */
    function ownsDayDoc(id) { return id.split('_')[1] == uid(); }
    function isServerTime(value) { return value == request.time; }
    /** Size helpers: a string field, present or absent, never over `max` chars. */
    function strMax(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }
    /** Media we render must come from our own Cloudinary cloud (or GIPHY for gifs). */
    // Our cloud's delivery URLs: authenticated (signed, s--sig--) or legacy public upload.
    function cloudinaryUrl(url) { return url is string && url.matches('^https://res\\.cloudinary\\.com/__CLOUDINARY_CLOUD__/(image|video)/(upload|authenticated/s--[A-Za-z0-9_-]{8}--)/.*'); }
    // Signed variant URLs stored next to an asset (see /api/media/urls); each must be ours.
    function variantOk(v, k) { return !(k in v) || cloudinaryUrl(v[k]); }
    function variantsOk(m) {
      return !('variants' in m) || (m.variants is map
        && m.variants.keys().hasOnly(['w320', 'w640', 'w800', 'blur', 'original', 'face', 'audio'])
        && variantOk(m.variants, 'w320') && variantOk(m.variants, 'w640') && variantOk(m.variants, 'w800')
        && variantOk(m.variants, 'blur') && variantOk(m.variants, 'original') && variantOk(m.variants, 'face')
        && variantOk(m.variants, 'audio'));
    }
    function giphyUrl(url) { return url is string && url.matches('^https://media[0-9]*\\.giphy\\.com/.*'); }

    // ── users/{uid} ──────────────────────────────────────────────────────
    match /users/{userId} {
      function userFields() {
        return ['name', 'nickname', 'email', 'photoURL', 'avatar', 'previousAvatarPublicId', 'bio',
                'tz', 'city', 'lat', 'lng', 'fcmTokens', 'notif', 'wordleSolved', 'createdAt'];
      }
      function userShape() {
        return incoming().keys().hasOnly(userFields())
          && incoming().nickname is string && incoming().nickname.size() > 0 && incoming().nickname.size() <= 24
          && strMax(incoming(), 'bio', 120) && strMax(incoming(), 'city', 80) && strMax(incoming(), 'name', 120)
          && incoming().tz is string && incoming().tz.size() > 0 && incoming().tz.size() <= 64
          && incoming().fcmTokens is list && incoming().fcmTokens.size() <= 10
          && (!('avatar' in incoming()) || incoming().avatar == null || (cloudinaryUrl(incoming().avatar.url) && variantsOk(incoming().avatar)));
      }
      // The chat wallpaper moved to pair/main.chatBg (phase 22b); a legacy users.chatBg can only be deleted.
      allow read: if allowed();
      allow create: if isMe(userId)
        && incoming().email.lower() == request.auth.token.email.lower()
        && isServerTime(incoming().createdAt)
        && userShape();
      // Only the owner may write — this covers fcmTokens and notif prefs too.
      // Identity fields never change after onboarding.
      allow update: if isMe(userId)
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && userShape();
      allow delete: if false;
    }

    // ── pair/main ────────────────────────────────────────────────────────
    match /pair/main {
      allow read: if allowed();
      // First sign-in creates the pair with just this user.
      allow create: if allowed()
        && incoming().uids == [uid()]
        && incoming().roomTz is string && incoming().roomTz.size() > 0;
      // Either friend may update, but uids can only grow to two, never lose
      // anyone, and must always include the writer.
      allow update: if allowed()
        && incoming().uids is list
        && incoming().uids.size() <= 2
        && incoming().uids.hasAll(existing().uids)
        && uid() in incoming().uids
        && incoming().roomTz is string && incoming().roomTz.size() > 0
        && chatBgOk();
      allow delete: if false;
      // Shared chat wallpaper: a short built-in id, or "photo" pointing at one of our Cloudinary assets.
      function chatBgOk() {
        return !('chatBg' in incoming()) || incoming().chatBg == null
          || (incoming().chatBg is map
              && incoming().chatBg.keys().hasOnly(['id', 'photoUrl', 'photoPublicId'])
              && incoming().chatBg.id is string && incoming().chatBg.id.size() <= 24
              && (!('photoUrl' in incoming().chatBg) || incoming().chatBg.photoUrl == null || cloudinaryUrl(incoming().chatBg.photoUrl)));
      }
    }

    // ── messages ─────────────────────────────────────────────────────────
    match /messages/{messageId} {
      function isSender() { return existing().senderId == uid(); }
      function recipientMarks() {
        return !isSender() && onlyChanges(['deliveredAt', 'readAt', 'status']);
      }
      function senderEdits() {
        return isSender()
          && onlyChanges(['text', 'editedAt', 'deletedForEveryone', 'media'])
          && incoming().text is string && incoming().text.size() <= 2000
          && (!('media' in incoming()) || incoming().media == null || incoming().media == existing().media);
      }
      function reacts() {
        return onlyChanges(['reactions']) && mapDiffKeys('reactions').hasOnly([uid()]);
      }
      function hidesForSelf() {
        return onlyChanges(['deletedFor'])
          && incoming().deletedFor is list
          && incoming().deletedFor.hasAll(existing().get('deletedFor', []))
          && incoming().deletedFor.removeAll(existing().get('deletedFor', [])).hasOnly([uid()]);
      }

      function messageFields() {
        return ['senderId', 'type', 'text', 'media', 'replyTo', 'reactions', 'status',
                'deliveredAt', 'readAt', 'editedAt', 'deletedFor', 'deletedForEveryone', 'createdAt',
                'kind', 'meta'];
      }
      // kind + meta exist on system lines only: a short kind id and a small flat map.
      function systemExtrasOk() {
        return (incoming().type == 'system' || (!('kind' in incoming()) && !('meta' in incoming())))
          && (!('kind' in incoming()) || (incoming().kind is string && incoming().kind.size() > 0 && incoming().kind.size() <= 32))
          && (!('meta' in incoming()) || (incoming().meta is map && incoming().meta.size() <= 8))
          && (incoming().get('kind', '') != 'invite' || inviteMetaOk(incoming().get('meta', {})));
      }
      // An invite line (phase 21) carries where Join goes and when the card expires.
      function inviteMetaOk(m) {
        return m.keys().hasAll(['route', 'activity', 'label', 'expiresAt'])
          && m.keys().hasOnly(['route', 'activity', 'label', 'expiresAt', 'roundId'])
          && m.route is string && m.route.matches('^/([A-Za-z0-9_?=&.-][A-Za-z0-9/_?=&.-]{0,98})?$')
          && m.activity is string && m.activity.size() >= 1 && m.activity.size() <= 32
          && m.label is string && m.label.size() >= 1 && m.label.size() <= 80
          && m.expiresAt is number
          && (!('roundId' in m) || (m.roundId is string && m.roundId.size() <= 64));
      }
      function mediaOk() {
        return !('media' in incoming()) || incoming().media == null
          || (incoming().type == 'gif' && giphyUrl(incoming().media.url))
          || (incoming().type == 'sticker' && incoming().media.stickerId is string)
          || (incoming().type in ['image', 'voice'] && cloudinaryUrl(incoming().media.url) && variantsOk(incoming().media));
      }

      allow read: if allowed();
      allow create: if allowed()
        && incoming().keys().hasOnly(messageFields())
        && incoming().senderId == uid()
        && incoming().status == 'sent'
        && incoming().type in ['text', 'image', 'voice', 'gif', 'sticker', 'system']
        && incoming().text is string && incoming().text.size() <= 2000
        && mediaOk()
        && systemExtrasOk()
        && isServerTime(incoming().createdAt);
      allow update: if allowed() && (recipientMarks() || senderEdits() || reacts() || hidesForSelf());
      // Deleting is a flag (deletedForEveryone), never a hard delete.
      allow delete: if false;
    }

    // ── playlists/{room}: the saved Watch / Listen lists ────────────────
    match /playlists/{room} {
      function roomOk() { return room in ['watch', 'listen']; }
      allow read: if allowed() && roomOk();
      allow create, update: if allowed() && roomOk()
        && incoming().keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && incoming().items is list && incoming().items.size() <= 50
        && incoming().updatedBy == uid()
        && isServerTime(incoming().updatedAt);
      allow delete: if false;
    }

    // ── checkins/{dateKey}: { uid: true } ────────────────────────────────
    match /checkins/{dateKey} {
      allow read: if allowed();
      allow create: if allowed()
        && incoming().keys().hasOnly([uid()])
        && incoming()[uid()] == true;
      allow update: if allowed()
        && onlyChanges([uid()])
        && incoming()[uid()] == true;
      allow delete: if false;
    }

    // ── moods/{dateKey}_{uid} ────────────────────────────────────────────
    match /moods/{moodId} {
      // note ≤ 80, emoji short
      // If the mirror fields are present they must match the doc id (history relies on them).
      function mirrorsOk() {
        return (!('uid' in incoming()) || incoming().uid == uid())
          && (!('dateKey' in incoming()) || incoming().dateKey == moodId.split('_')[0]);
      }
      allow read: if allowed();
      allow create, update: if allowed() && ownsDayDoc(moodId)
        && incoming().emoji is string && incoming().emoji.size() <= 8
        && strMax(incoming(), 'note', 80) && mirrorsOk();
      allow delete: if allowed() && ownsDayDoc(moodId);
    }

    // ── dailyQuestions/{dateKey} ─────────────────────────────────────────
    match /dailyQuestions/{dateKey} {
      function dateKeyOk() { return !('dateKey' in incoming()) || incoming().dateKey == dateKey; }
      allow read: if allowed();
      allow create: if allowed()
        && incoming().questionIndex is int
        && incoming().get('answers', {}).keys().hasOnly([uid()])
        && dateKeyOk();
      // Each person may only touch their own answer (plus the id-mirroring dateKey).
      allow update: if allowed()
        && onlyChanges(['answers', 'dateKey'])
        && mapDiffKeys('answers').hasOnly([uid()])
        && dateKeyOk();
      allow delete: if false;
    }

    // ── journal ──────────────────────────────────────────────────────────
    match /journal/{entryId} {
      allow read: if allowed();
      allow create: if allowed() && incoming().authorId == uid()
        && isServerTime(incoming().createdAt) && strMax(incoming(), 'text', 4000);
      allow update: if allowed() && existing().authorId == uid() && incoming().authorId == uid();
      allow delete: if allowed() && existing().authorId == uid();
    }

    // ── capsules (+ time-gated body) ─────────────────────────────────────
    match /capsules/{capsuleId} {
      function isAuthor() { return existing().authorId == uid(); }
      function unlocked() { return request.time >= existing().unlockAt; }

      allow read: if allowed();
      allow create: if allowed()
        && incoming().authorId == uid()
        && incoming().unlockAt is timestamp;
      allow update: if allowed() && (
        (isAuthor() && incoming().authorId == uid())
        || (unlocked()
            && onlyChanges(['openedAt', 'openedBy'])
            && incoming().openedBy == uid())
      );
      // Authors may take a capsule back only while it's still sealed (the server
      // route also removes its photos and private body).
      allow delete: if allowed() && isAuthor() && request.time < existing().unlockAt;

      // The letter itself lives here so the recipient can't read it early.
      match /private/body {
        function capsule() { return get(/databases/$(database)/documents/capsules/$(capsuleId)).data; }
        function capsuleAfter() { return getAfter(/databases/$(database)/documents/capsules/$(capsuleId)).data; }
        allow read: if allowed()
          && (capsule().authorId == uid() || request.time >= capsule().unlockAt);
        allow write: if allowed() && capsuleAfter().authorId == uid();
      }
    }

    // ── envelopes (open-when letters; body in a subdoc, one-way opening) ─
    match /envelopes/{envelopeId} {
      function isAuthor() { return existing().authorId == uid(); }
      function isRecipient() { return existing().forUid == uid(); }
      function unopened() { return !hasField(existing(), 'openedAt'); }

      allow read: if allowed();
      allow create: if allowed()
        && incoming().authorId == uid()
        && incoming().forUid != uid()
        && incoming().label is string;
      allow update: if allowed() && (
        // Author may edit while it's still sealed.
        (isAuthor() && unopened() && incoming().authorId == uid() && !hasField(incoming(), 'openedAt'))
        // Recipient may open it exactly once; opening stamps the server time.
        || (isRecipient() && unopened()
            && onlyChanges(['openedAt'])
            && isServerTime(incoming().openedAt))
      );
      allow delete: if allowed() && isAuthor() && unopened();

      match /private/body {
        function envelope() { return get(/databases/$(database)/documents/envelopes/$(envelopeId)).data; }
        function envelopeAfter() { return getAfter(/databases/$(database)/documents/envelopes/$(envelopeId)).data; }
        allow read: if allowed() && (
          envelope().authorId == uid()
          || (envelope().forUid == uid() && hasField(envelope(), 'openedAt'))
        );
        allow write: if allowed() && envelopeAfter().authorId == uid();
      }
    }

    // ── scheduled messages (delivered by the server) ─────────────────────
    match /scheduled/{scheduledId} {
      function isSender() { return existing().senderId == uid(); }
      function unsent() { return !hasField(existing(), 'sentAt'); }

      allow read: if allowed() && isSender();
      allow create: if allowed()
        && incoming().senderId == uid()
        && incoming().sendAt is timestamp
        && !hasField(incoming(), 'sentAt');
      allow update: if allowed() && isSender() && unsent()
        && incoming().senderId == uid() && !hasField(incoming(), 'sentAt');
      allow delete: if allowed() && isSender() && unsent();
    }

    // ── jar ──────────────────────────────────────────────────────────────
    match /jar/{noteId} {
      function isAuthor() { return existing().authorId == uid(); }
      function undrawn() { return !hasField(existing(), 'drawnAt'); }

      allow read: if allowed();
      allow create: if allowed()
        && incoming().authorId == uid()
        && incoming().forUid != uid()
        && strMax(incoming(), 'text', 500)
        && !hasField(incoming(), 'drawnAt');
      allow update: if allowed() && (
        (isAuthor() && undrawn() && incoming().authorId == uid() && !hasField(incoming(), 'drawnAt'))
        || (existing().forUid == uid() && undrawn()
            && onlyChanges(['drawnAt'])
            && isServerTime(incoming().drawnAt))
      );
      allow delete: if allowed() && isAuthor() && undrawn();
    }

    // ── memories & places ────────────────────────────────────────────────
    match /memories/{memoryId} {
      allow read: if allowed();
      allow create: if allowed() && incoming().uploaderId == uid()
        && cloudinaryUrl(incoming().url) && variantsOk(incoming()) && strMax(incoming(), 'caption', 500)
        && isServerTime(incoming().createdAt);
      // Only the uploader edits caption/date/place; the asset fields never change.
      allow update: if allowed()
        && existing().uploaderId == uid()
        && incoming().uploaderId == existing().uploaderId
        && incoming().url == existing().url
        && incoming().publicId == existing().publicId
        && strMax(incoming(), 'caption', 500);
      // Either of you may unlink a photo from a place that is being deleted in the same batch
      // (or is already gone): only placeId may change, and only to null.
      allow update: if allowed()
        && onlyChanges(['placeId']) && incoming().placeId == null
        && existing().get('placeId', null) is string
        && !existsAfter(/databases/$(database)/documents/places/$(existing().placeId));
      allow delete: if allowed() && existing().uploaderId == uid();
    }

    match /places/{placeId} {
      allow read: if allowed();
      allow create: if allowed() && incoming().addedBy == uid() && strMax(incoming(), 'note', 1000) && strMax(incoming(), 'name', 80);
      allow update: if allowed() && strMax(incoming(), 'note', 1000) && strMax(incoming(), 'name', 80);
      allow delete: if allowed();
    }

    // ── milestones ───────────────────────────────────────────────────────
    match /milestones/{milestoneId} {
      allow read, write: if allowed();
    }

    // ── lists/{kind}/items/{id} ──────────────────────────────────────────
    match /lists/{kind} {
      allow read: if allowed();
      allow write: if allowed() && kind in ['bucket', 'wishlist', 'gifts', 'todo'];

      match /items/{itemId} {
        // Gift ideas are private to whoever wrote them; the other lists are shared.
        function mineOrShared() { return kind != 'gifts' || existing().addedBy == uid(); }
        allow read: if allowed() && mineOrShared();
        allow create: if allowed()
          && kind in ['bucket', 'wishlist', 'gifts', 'todo']
          && incoming().addedBy == uid()
          && strMax(incoming(), 'text', 200) && strMax(incoming(), 'note', 1000) && strMax(incoming(), 'url', 500);
        allow update: if allowed() && mineOrShared() && incoming().addedBy == existing().addedBy
          && strMax(incoming(), 'text', 200) && strMax(incoming(), 'note', 1000) && strMax(incoming(), 'url', 500);
        allow delete: if allowed() && mineOrShared();
      }
    }

    // ── trips ────────────────────────────────────────────────────────────
    match /trips/{tripId} {
      allow read, write: if allowed();
    }

    // ── availability/{uid} ───────────────────────────────────────────────
    match /availability/{userId} {
      allow read: if allowed();
      allow write: if isMe(userId);
    }

    // ── gameResults ──────────────────────────────────────────────────────
    match /gameResults/{resultId} {
      allow read: if allowed();
      // Written once by whichever client finalises the game; never edited.
      allow create: if allowed() && uid() in incoming().players;
      allow update, delete: if false;
    }

    // ── quizzes (know-me) ────────────────────────────────────────────────
    match /quizzes/{quizId} {
      function isAuthor() { return existing().authorId == uid(); }
      allow read: if allowed();
      allow create: if allowed() && incoming().authorId == uid();
      allow update: if allowed() && (
        (isAuthor() && incoming().authorId == uid())
        // The taker may only write their own result.
        || (!isAuthor()
            && onlyChanges(['takenBy'])
            && mapDiffKeys('takenBy').hasOnly([uid()]))
      );
      allow delete: if allowed() && isAuthor();
    }

    // ── wordle/{dateKey}_{uid} ───────────────────────────────────────────
    match /wordle/{gameId} {
      allow read: if allowed();
      allow create, update: if allowed() && ownsDayDoc(gameId)
        && incoming().guesses is list && incoming().guesses.size() <= 6;
      allow delete: if false;
    }

    // ── trivia ───────────────────────────────────────────────────────────
    match /trivia/{triviaId} {
      allow read: if allowed();
      allow create: if allowed()
        && incoming().questionIds is list
        && incoming().get('answers', {}).keys().hasOnly([uid()]);
      // Either may update scores/timing, but only their own answers.
      allow update: if allowed()
        && incoming().questionIds == existing().questionIds
        && mapDiffKeys('answers').hasOnly([uid()]);
      allow delete: if false;
    }

    // ── recipes ──────────────────────────────────────────────────────────
    match /recipes/{recipeId} {
      allow read: if allowed();
      allow create: if allowed() && incoming().addedBy == uid();
      allow update, delete: if allowed();
    }

    // ── server-only (firebase-admin bypasses rules) ──────────────────────
    match /push/{pushId} {
      allow read, write: if false;
    }
    match /tickLog/{jobKey} {
      allow read, write: if false;
    }
    match /quota/{entry} {
      allow read, write: if false;
    }
  }
}
