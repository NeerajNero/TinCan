# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is the committed template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase rules are generated from rules/*.tmpl by scripts/build-rules.mjs
/firestore.rules
/database.rules.json
/.firebaserc

# firebase emulator logs (pnpm test:rules)
*-debug.log
ui-debug.log

# playwright
/test-results/
/playwright-report/

# data exports (pnpm export): private, never commit
/exports/

# Claude Code: personal overrides stay local (.claude/settings.json is shared)
/.claude/settings.local.json
