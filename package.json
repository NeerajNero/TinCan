{
  "name": "tincan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "icons": "node scripts/icons.mjs",
    "words:definitions": "node scripts/build-word-definitions.mjs",
    "rules:deploy": "pnpm rules:build && firebase deploy --only firestore:rules,firestore:indexes,database",
    "rules:build": "node scripts/build-rules.mjs",
    "cloudinary:presets": "node scripts/cloudinary-presets.mjs",
    "tick:dry": "node scripts/tick-dry.mjs",
    "reset:dry": "node scripts/reset-data.mjs",
    "reset": "node scripts/reset-data.mjs --yes",
    "test:rules": "pnpm rules:build && firebase emulators:exec --only firestore,database \"vitest run --config vitest.rules.config.mts\"",
    "test": "vitest run",
    "analyze": "ANALYZE=true next build",
    "knip": "knip",
    "profile:chat": "vitest run --config vitest.perf.config.mts",
    "size": "node scripts/measure-routes.mjs",
    "test:e2e": "next build && playwright test",
    "migrate-media": "node scripts/migrate-media-authenticated.mjs",
    "export": "node scripts/export-data.mjs"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "chess.js": "^1.4.0",
    "cloudinary": "^2.11.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.2.0",
    "hls.js": "1.7.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@serwist/turbopack": "^9.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "happy-dom": "^21.0.3",
    "knip": "^6.41.0",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wordnet-db": "^3.1.14"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "overrides": {
      "jose": "5.10.0",
      "@grpc/grpc-js": ">=1.13.6"
    }
  }
}
