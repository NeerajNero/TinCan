# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                 # e.g. https://tincan.vercel.app (no trailing slash)

# ── Firebase (Spark plan) — web app config from the Firebase console ────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=   # Realtime Database URL
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=      # Cloud Messaging → Web Push certificates

# ── Firebase Admin (server routes only) ─────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=            # base64 of the service-account JSON: base64 -i sa.json | tr -d '\n'
ALLOWED_EMAILS=                      # the two Google emails, comma-separated

# ── Cloudinary (free) ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_PRESET_IMAGE=tincan_image
NEXT_PUBLIC_CLOUDINARY_PRESET_AUDIO=tincan_audio
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Scheduler (/api/tick, pinged by cron-job.org every 15 min) ──────────────
TICK_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
GIPHY_API_KEY=                       # server-only; the GIF tab is hidden when absent

# ── Debug ───────────────────────────────────────────────────────────────────
CSP_REPORT_ONLY=                     # set to 1 to switch the CSP header back to report-only
