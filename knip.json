{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/sw.ts",
    "tests/**/*.test.ts",
    "vitest.rules.config.mts",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreBinaries": [
    "firebase"
  ],
  "ignoreDependencies": [
    "tailwindcss"
  ]
}
